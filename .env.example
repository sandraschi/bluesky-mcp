# Bluesky PDS (default AppView entry). Custom PDS URLs work too.
BLUESKY_PDS=https://bsky.social
# Alias accepted by config:
# BLUESKY_INSTANCE=https://bsky.social

# Handle (without or with @) + app password from bsky.app Settings → App Passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Optional: skip createSession when you already have a session JWT + DID
# BLUESKY_ACCESS_TOKEN=
# BLUESKY_DID=

# Safety — keep 1 until you intentionally publish
BLUESKY_DRY_RUN=1
BLUESKY_REQUIRE_OUTBOX_APPROVAL=1

# Ports
BLUESKY_BACKEND_PORT=10760
# Frontend Vite: 10761 (vite.config / start.ps1)

# Inbound fleet webhooks (POST /api/v1/webhooks/inbound)
# Header: X-Bluesky-Webhook-Secret
BLUESKY_WEBHOOK_SECRET=
